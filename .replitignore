# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
/services/zeronyth-l1/.env
/services/zeronyth-l1/node-data
/services/zeronyth-l1/networkFiles
/services/zeronyth-l1/network-hosts
/services/zeronyth-l1/config/genesis.json
/services/zeronyth-l1/config/static-nodes.json
/services/zeronyth-l1/config/validators.json
