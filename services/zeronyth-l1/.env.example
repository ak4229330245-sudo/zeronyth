# ZERONYTH L1 — example environment. Copy to .env and fill in your own values.
# Never commit a real .env. All values below are placeholders.

# Optional: pre-fund one wallet during local network initialization (0x-prefixed EVM address).
FUNDED_ADDRESS=
# 1,000,000 ZNYT in wei (hex).
FUNDED_BALANCE_WEI=0xd3c21bcecceda1000000

# RPC used by helper scripts.
RPC_URL=http://127.0.0.1:8545

# Faucet signer. Use a dedicated, test-only key. Never put a key that holds real funds here.
FAUCET_PRIVATE_KEY=<your-test-faucet-private-key>
FAUCET_ADDRESS=<faucet-address>
FAUCET_BALANCE_WEI=0x52b7d2dcc80cd2e4000000
FAUCET_DRIP_ZNYT=10
FAUCET_COOLDOWN_MS=86400000
FAUCET_MAX_QUEUE=32

# --- Optional service secrets (only needed for the services that read them) ---
# AI chat admin endpoints
ZERONYTH_AI_ADMIN_TOKEN=<random-long-token>
# Validator-application admin endpoints
ZERONYTH_JOIN_ADMIN_TOKEN=<random-long-token>
# Contract deployer / AMM price keeper / points publisher (test-only keys)
ZERONYTH_DEPLOYER_KEY=<test-deployer-private-key>
ZERONYTH_AMM_KEEPER_KEY=<test-keeper-private-key>
ZERONYTH_POINTS_PUBLISHER_KEY=<test-publisher-private-key>
# Bridge relayer key file (JSON, chmod 600, kept outside the repo)
BRIDGE_KEYS_FILE=$HOME/.zeronyth-secrets/bridge-keys.json

# --- Ops scripts (deploy/box-primary) ---
ZERONYTH_VPS_SSH=deploy@YOUR_VPS_IP
ZERONYTH_VPS_SSH_KEY=$HOME/.ssh/id_ed25519
# Comma-separated operator IPs excluded from the visitor counter
ZERONYTH_OWN_IPS=
