# Live VPS copy (~/zeronyth-cloudflared/config.yml, pm2 zeronyth-cloudflared) as of 2026-10-27; credentials path redacted.
# ZERONYTH public tunnel, run on the VPS. Origin = box gateway (22780) via the box ssh reverse forward 127.0.0.1:22781.
# Since 2026-10-27 cloudflared targets the zeronyth-edge fallback (vps/zeronyth-edge.mjs): 22790 main, 22791 scan.
# The edge passes everything through to 22781/22815 and serves a local fallback while the box is paused.
tunnel: <TUNNEL-ID>
credentials-file: /home/solbot/.cloudflared/<TUNNEL-ID>.json
no-autoupdate: true
ingress:
  # ZERONYTH Scan (standalone explorer) -> box 9815 via ssh -R 127.0.0.1:22815
  - hostname: scan.zeronyth.dpdns.org
    service: http://127.0.0.1:22791
    originRequest:
      connectTimeout: 10s
      noHappyEyeballs: true
  # Legacy wallet explorer paths on the main site -> explorer, which 301s them to scan.zeronyth.dpdns.org
  - hostname: zeronyth.dpdns.org
    path: ^/(tx|address|block|token)/|^/explorer/?$
    service: http://127.0.0.1:22791
    originRequest:
      connectTimeout: 10s
      noHappyEyeballs: true
  - hostname: zeronyth.dpdns.org
    service: http://127.0.0.1:22790
    originRequest:
      connectTimeout: 10s
      noHappyEyeballs: true
      httpHostHeader: localhost
  - service: http_status:404
