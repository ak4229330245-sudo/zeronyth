# ZERONYTH public launch — runtime settings for the box primary (copy values into the pm2 ecosystem env).
# Gateway (behind cloudflared on 127.0.0.1:22780)
ZERONYTH_TRUST_CF=1            # use CF-Connecting-IP only when the TCP peer is loopback (cloudflared)
ZERONYTH_RPC_RPS=30            # read-only /rpc, per visitor IP per second
ZERONYTH_MIN_GAS_PRICE=1000000000   # 1 gwei on the PUBLIC chain (fee approval required before changing the live chain)
# Faucet (gas drip only; the 10% early-participant bucket is distributed separately, not by the faucet)
FAUCET_DRIP_ZNYT=1
FAUCET_COOLDOWN_MS=60000
FAUCET_ADDR_DAILY=1            # 1 drip per address per day
FAUCET_IP_DAILY=3              # 3 drips per visitor IP per day (gateway passes the IP; faucet is loopback-only)
FAUCET_GLOBAL_DAILY=2000       # hard budget: 2,000 ZNYT/day max -> the 100,000 faucet allocation lasts >= 50 days
FAUCET_SKIP_IF_FUNDED=1        # refuse addresses that already hold >= 1 drip
FAUCET_STATE_FILE=/workspace/zeronyth-primary/generated-artifacts/faucet-daily.json
# FAUCET_PRIVATE_KEY is loaded from launch/public/secrets/faucet.key by the operator (never commit, never paste in chat)
